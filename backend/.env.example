# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=novaris_db
DB_USER=novaris_user
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432

# CORS — comma-separated origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (password reset) — console backend prints to the runserver log,
# no real setup needed for local dev. Swap EMAIL_BACKEND for a real
# provider (SES/SendGrid/SMTP) in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@novaris.example.com

# Used to build the password-reset link emailed to the user
FRONTEND_URL=http://localhost:5173
