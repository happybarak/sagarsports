# Django Core & Security
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,sagarsports.shop,www.sagarsports.shop,api.sagarsports.shop
CSRF_TRUSTED_ORIGINS=https://sagarsports.shop,https://www.sagarsports.shop,https://api.sagarsports.shop

# Database (PostgreSQL)
DB_NAME=sagarsports_db
DB_USER=sagarsports_user
DB_PASSWORD=change-this-database-password
DB_HOST=localhost
DB_PORT=5432
DB_SSL_REQUIRE=true

# CORS — origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sagarsports.shop,https://www.sagarsports.shop

# JWT Token Lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudflare R2 / S3 Object Storage (for product images)
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=media.sagarsports.shop

# Transactional Email (Brevo HTTPS API for Render / SendGrid / SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-login
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=sagarsports.orders@gmail.com
ADMIN_NOTIFICATION_EMAIL=sagarsports.shop@gmail.com
# Brevo HTTPS REST API Key (bypasses Render Free SMTP port 587 block)
BREVO_API_KEY=your_brevo_api_key

# Frontend URL
FRONTEND_URL=https://sagarsports.shop

# Razorpay Payment Gateway (Test keys: rzp_test_... / Live keys: rzp_live_...)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
